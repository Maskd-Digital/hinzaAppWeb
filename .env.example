# Browser calls same-origin proxy (next.config.ts rewrites → hinza.vercel.app)
# Do NOT set this to https://hinza.vercel.app in the browser — CORS will block it.
NEXT_PUBLIC_API_BASE_URL=/hinza-api

# Upstream API used by the Next.js rewrite (server-side only)
API_BASE_URL=https://hinza.vercel.app

# Supabase (same project as the Flutter app — anon key only)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
